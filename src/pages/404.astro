---
import MainGridLayout from "@layouts/MainGridLayout.astro";
---

<MainGridLayout title="404">
    <Fragment slot="head">
        <meta name="robots" content="noindex" />
    </Fragment>

    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-12 relative w-full flex flex-col items-center justify-center text-center">
            <div class="text-[5rem] leading-none font-bold text-[var(--primary)] mb-4">404</div>
            <div class="text-black/75 dark:text-white/75 mb-8">页面不存在 / Page not found</div>
            <a href="/" class="transition rounded-xl px-5 py-2.5 bg-[var(--primary)] text-white font-medium hover:opacity-90 active:scale-95">
                返回首页
            </a>
        </div>
    </div>
</MainGridLayout>
